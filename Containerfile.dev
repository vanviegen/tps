# Dev container image for this project (Containerfile.dev).
#
# TPS builds it with the task's repo clone as the (only) build context, and
# runs the task in it as uid 1000 with that clone mounted at /work. code-server
# and claude are mounted in at run time, so nothing here is TPS-specific: use
# whatever base suits the project, as long as it has bash and git, and a user
# with uid 1000 who owns a home directory. A CMD line that starts what the
# project serves gives the dashboard a Run button, and the ports EXPOSE names
# are forwarded to it.
#
# TPS itself needs Go (the binary) and node (only to bundle the web UI).

FROM docker.io/library/debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git sudo bash procps psmisc ripgrep less nano \
      openssh-client unzip zip xz-utils build-essential pkg-config \
    && rm -rf /var/lib/apt/lists/*
# The docker CLI, with compose: TPS serves the task a docker socket (backed by
# podman) for containers of its own, and the client is the image's to provide.
ARG DOCKER_VERSION=27.5.1 COMPOSE_VERSION=2.32.4
RUN arch="$(uname -m)" \
    && curl -fsSL "https://download.docker.com/linux/static/stable/${arch}/docker-${DOCKER_VERSION}.tgz" \
       | tar -C /usr/local/bin --strip-components=1 -xz docker/docker \
    && curl -fsSL --create-dirs -o /usr/local/lib/docker/cli-plugins/docker-compose \
       "https://github.com/docker/compose/releases/download/v${COMPOSE_VERSION}/docker-compose-linux-${arch}" \
    && chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
# A podman that is the docker CLI in disguise, so that a TPS daemon started in
# here (the CMD below) can run task containers of its own through the docker
# socket TPS serves it: the spellings docker lacks (`image exists`, `rm -t`, the
# --userns that siblings cannot have anyway) are translated, and the rest of the
# CLI mirrors podman's. Not a podman.
RUN printf '%s\n' '#!/bin/sh' \
    '[ "$1 $2" = "image exists" ] && exec docker image inspect "$3" >/dev/null 2>&1' \
    'cmd=$1; n=$#' \
    'while [ $n -gt 0 ]; do a=$1; shift; n=$((n-1))' \
    '  case "$a" in' \
    '    -t) if [ "$cmd" = rm ]; then shift; n=$((n-1)); continue; fi ;;' \
    '    --userns=*) continue ;;' \
    '    --userns) shift; n=$((n-1)); continue ;;' \
    '  esac' \
    '  set -- "$@" "$a"' \
    'done' \
    'exec docker "$@"' >/usr/local/bin/podman && chmod +x /usr/local/bin/podman

ARG GO_VERSION=1.24.7
ARG NODE_VERSION=22.19.0
RUN arch="$(dpkg --print-architecture)" \
    && curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${arch}.tar.gz" | tar -C /usr/local -xz \
    && case "$arch" in amd64) narch=x64 ;; arm64) narch=arm64 ;; *) narch="$arch" ;; esac \
    && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${narch}.tar.xz" \
       | tar -C /usr/local --strip-components=1 -xJ
ENV PATH=/usr/local/go/bin:/usr/local/bin:/home/dev/go/bin:$PATH \
    GOPATH=/home/dev/go GOTOOLCHAIN=auto
# Login shells (what the agent and VS Code terminals get) reset PATH from
# /etc/profile, so put Go on it there as well.
RUN printf 'PATH=/usr/local/go/bin:/usr/local/bin:$HOME/go/bin:$PATH\n' >/etc/profile.d/go.sh

RUN useradd -m -u 1000 -s /bin/bash dev && echo 'dev ALL=(ALL) NOPASSWD:ALL' >/etc/sudoers.d/dev
USER dev
WORKDIR /work

# Run TPS itself, so the dashboard's Run button previews this project: the web
# bundle first, then the binary on the exposed port. It listens on 0.0.0.0
# because the forwarded port arrives on the container's own address, not its
# loopback; TPS publishes that port on the host's loopback, so this is not
# exposure.
EXPOSE 8080
CMD npm install --silent && npm run build && go run . --host 0.0.0.0 --port 8080 --no-open
