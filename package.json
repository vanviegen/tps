{
  "name": "tps",
  "version": "0.1.0",
  "description": "TPS: a kanban-style manager for AI coding agents working in podman dev containers, local or over SSH",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "rm -rf web/dist && esbuild web/main.ts --bundle --format=esm --splitting --minify --sourcemap --outdir=web/dist --entry-names=app",
    "icons": "node web/icons.mjs",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc -p web"
  },
  "dependencies": {
    "aberdeen": "^1.23.0",
    "marked": "^18.0.11",
    "staffa": "^0.22.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
